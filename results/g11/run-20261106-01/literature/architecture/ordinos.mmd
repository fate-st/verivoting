  S4["Validation and accumulation<br/>Validate board set; homomorphic sum"]
  S3 --> S4
  S5["Final tally<br/>Trustees evaluate result through MPC"]
  S4 --> S5
  S6["Disclosure<br/>Publish result and verifiable MPC transcript"]
  S5 --> S6
